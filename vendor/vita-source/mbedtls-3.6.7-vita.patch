     }
     *olen = len;
     return 0;
+#elif defined(__vita__)
+    ((void) file);
+    ((void) read_len);
+    if (vita_getentropy_wrapper(output, len) == -1) {
+        return MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;
+    }
+    *olen = len;
+    return 0;
 #else
 
     *olen = 0;
diff --git a/library/net_sockets.c b/library/net_sockets.c
index c919f6f..2656ee7 100644
--- a/library/net_sockets.c
+++ b/library/net_sockets.c
@@ -277,6 +277,36 @@ static int net_would_block(const mbedtls_net_context *ctx)
     ((void) ctx);
     return WSAGetLastError() == WSAEWOULDBLOCK;
 }
+#elif defined(__vita__)
+/* Modified for PlayStation Vita by Vita Moonlight contributors, 2026. */
+/*
+ * Check if the requested operation would be blocking on a non-blocking socket
+ * and thus 'failed' with a negative return value.
+ */
+static int net_would_block(const mbedtls_net_context *ctx)
+{
+    int err = errno;
+    long b = 0L;
+    socklen_t b_size = sizeof(b);
+
+    /* Never report WOULD BLOCK for a blocking socket. */
+    if (getsockopt(ctx->fd, SOL_SOCKET, SO_NONBLOCK, &b, &b_size) != 0 ||
+        b != 1L) {
+        errno = err;
+        return 0;
+    }
+
+    switch (errno = err) {
+#if defined(EAGAIN)
+        case EAGAIN:
+#endif
+#if defined(EWOULDBLOCK) && EWOULDBLOCK != EAGAIN
+        case EWOULDBLOCK:
+#endif
+            return 1;
+    }
+    return 0;
+}
 #else
 /*
  * Check if the requested operation would be blocking on a non-blocking socket
@@ -324,6 +354,7 @@ int mbedtls_net_accept(mbedtls_net_context *bind_ctx,
 #if defined(__socklen_t_defined) || defined(_SOCKLEN_T) ||  \
     defined(_SOCKLEN_T_DECLARED) || defined(__DEFINED_socklen_t) || \
-    defined(socklen_t) || (defined(_POSIX_VERSION) && _POSIX_VERSION >= 200112L)
+    defined(socklen_t) || (defined(_POSIX_VERSION) && _POSIX_VERSION >= 200112L) || \
+    defined(__vita__)
     socklen_t n = (socklen_t) sizeof(client_addr);
     socklen_t type_len = (socklen_t) sizeof(type);
 #else
@@ -428,6 +458,9 @@ int mbedtls_net_set_block(mbedtls_net_context *ctx)
     !defined(EFI32)
     u_long n = 0;
     return ioctlsocket(ctx->fd, FIONBIO, &n);
+#elif defined(__vita__)
+    long b = 0L;
+    return setsockopt(ctx->fd, SOL_SOCKET, SO_NONBLOCK, &b, sizeof(b));
 #else
     return fcntl(ctx->fd, F_SETFL, fcntl(ctx->fd, F_GETFL) & ~O_NONBLOCK);
 #endif
@@ -439,6 +472,9 @@ int mbedtls_net_set_nonblock(mbedtls_net_context *ctx)
     !defined(EFI32)
     u_long n = 1;
     return ioctlsocket(ctx->fd, FIONBIO, &n);
+#elif defined(__vita__)
+    long b = 1L;
+    return setsockopt(ctx->fd, SOL_SOCKET, SO_NONBLOCK, &b, sizeof(b));
 #else
     return fcntl(ctx->fd, F_SETFL, fcntl(ctx->fd, F_GETFL) | O_NONBLOCK);
 #endif
