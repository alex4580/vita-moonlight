@@ -145,6 +146,26 @@ static int sysctl_arnd_wrapper(unsigned char *buf, size_t buflen)
 #endif /* KERN_ARND */
 #endif /* __FreeBSD__ || __NetBSD__ */
 
+/* VitaSDK provides getentropy(), with a maximum of 256 bytes per call. */
+#if defined(__vita__)
+int getentropy(void *, size_t); /* Hidden behind __BSD_VISIBLE in VitaSDK. */
+
+static int vita_getentropy_wrapper(unsigned char *buf, size_t buflen)
+{
+    size_t len;
+
+    while (buflen > 0) {
+        len = buflen > 256 ? 256 : buflen;
+        if (getentropy(buf, len) == -1) {
+            return -1;
+        }
+        buflen -= len;
+        buf += len;
+    }
+    return 0;
+}
+#endif /* __vita__ */
+
 #include <stdio.h>
 
 const char *mbedtls_platform_dev_random = MBEDTLS_PLATFORM_DEV_RANDOM;
