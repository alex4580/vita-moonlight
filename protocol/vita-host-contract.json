{
  "schema": "vita-moonlight/host-client-contract/v1",
  "contract_version": 1,
  "stream": {
    "resolutions": [
      {
        "width": 960,
        "height": 544,
        "role": "vita-native"
      },
      {
        "width": 960,
        "height": 540,
        "role": "strict-16:9"
      },
      {
        "width": 1280,
        "height": 720,
        "role": "720p-compatibility"
      }
    ],
    "allowed_frame_rates_fps": [
      24,
      30,
      40,
      50,
      60
    ],
    "desktop_refresh_hz": 60,
    "capabilities": {
      "video_codecs": [
        "H264"
      ],
      "audio_configurations": [
        "STEREO"
      ],
      "color_space": "REC_709",
      "color_range": "LIMITED",
      "hdr": false
    }
  },
  "mode_control": {
    "authoritative_transport": "gamestream-launch-mode",
    "shared_sunshine_hook": {
      "command": "session hook-start",
      "recognized_contract_mode": "normalize-to-fixed-desktop-refresh",
      "unrecognized_mode": "pass-through-no-op"
    },
    "legacy_unacknowledged_hotkeys": [
      {
        "width": 960,
        "height": 540,
        "desktop_refresh_hz": 60,
        "key": "F8",
        "windows_virtual_key": 119
      },
      {
        "width": 960,
        "height": 544,
        "desktop_refresh_hz": 60,
        "key": "F9",
        "windows_virtual_key": 120
      },
      {
        "width": 1280,
        "height": 720,
        "desktop_refresh_hz": 60,
        "key": "F10",
        "windows_virtual_key": 121
      }
    ]
  },
  "companion_control": {
    "transport": "moonlight-encrypted-keyboard-input",
    "acknowledgement": "none",
    "modifiers": [
      {
        "key": "CONTROL",
        "windows_virtual_key": 17
      },
      {
        "key": "ALT",
        "windows_virtual_key": 18
      },
      {
        "key": "SHIFT",
        "windows_virtual_key": 16
      }
    ],
    "actions": [
      {
        "id": "recover-physical-display",
        "key": "F11",
        "windows_virtual_key": 122,
        "host_action": "display-recovery",
        "disconnect_after_send": true
      },
      {
        "id": "close-foreground-game",
        "key": "F12",
        "windows_virtual_key": 123,
        "host_action": "close-game",
        "disconnect_after_send": false
      }
    ]
  }
}
