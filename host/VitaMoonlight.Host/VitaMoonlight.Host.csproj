<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SelfContained>false</SelfContained>
    <Product>Vita Moonlight Host</Product>
    <AssemblyTitle>Vita Moonlight Host</AssemblyTitle>
    <Description>Windows host companion for Vita Moonlight streaming.</Description>
    <Authors>Vita Moonlight contributors</Authors>
    <Company>Vita Moonlight contributors</Company>
    <Version>0.14.7</Version>
    <InformationalVersion>0.14.7</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyVersion>0.14.7.0</AssemblyVersion>
    <FileVersion>0.14.7.0</FileVersion>
  </PropertyGroup>
</Project>
