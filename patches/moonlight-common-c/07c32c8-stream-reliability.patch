diff --git a/src/VideoStream.c b/src/VideoStream.c
index 402b056..080d74d 100644
--- a/src/VideoStream.c
+++ b/src/VideoStream.c
@@ -6,6 +6,8 @@
 #define FIRST_FRAME_PORT 47996
 
 static RTP_VIDEO_QUEUE rtpQueue;
+static VideoStreamDiagnostics videoDiagnostics;
+static uint32_t videoDiagnosticsEnabled;
 
 static SOCKET rtpSocket = INVALID_SOCKET;
 static SOCKET firstFrameSocket = INVALID_SOCKET;
@@ -417,3 +419,66 @@ int startVideoStream(void* rendererContext, int drFlags) {
 const RTP_VIDEO_STATS* LiGetRTPVideoStats(void) {
     return &rtpQueue.stats;
 }
+
+void LiSetVideoStreamDiagnosticsEnabled(bool enabled) {
+    __atomic_store_n(&videoDiagnosticsEnabled, enabled ? 1 : 0, __ATOMIC_RELAXED);
+}
+
+void addVideoStreamDiagnosticCount(VIDEO_DIAGNOSTIC_COUNTER counter, uint32_t amount) {
+    uint32_t* destination;
+
+    if (amount == 0 ||
+            __atomic_load_n(&videoDiagnosticsEnabled, __ATOMIC_RELAXED) == 0) {
+        return;
+    }
+
+    switch (counter) {
+        case VIDEO_DIAGNOSTIC_RTP_PACKET_OUT_OF_SEQUENCE:
+            destination = &videoDiagnostics.rtpPacketsOutOfSequence;
+            break;
+        case VIDEO_DIAGNOSTIC_FEC_DATA_PACKET_RECOVERED:
+            destination = &videoDiagnostics.fecDataPacketsRecovered;
+            break;
+        case VIDEO_DIAGNOSTIC_FEC_BLOCK_FAILED:
+            destination = &videoDiagnostics.fecBlocksFailed;
+            break;
+        case VIDEO_DIAGNOSTIC_NETWORK_FRAME_LOST:
+            destination = &videoDiagnostics.networkFramesLost;
+            break;
+        case VIDEO_DIAGNOSTIC_DEPACKETIZER_CORRUPT_FRAME:
+            destination = &videoDiagnostics.depacketizerCorruptFrames;
+            break;
+        case VIDEO_DIAGNOSTIC_DECODE_UNIT_QUEUE_OVERFLOW:
+            destination = &videoDiagnostics.decodeUnitQueueOverflows;
+            break;
+        case VIDEO_DIAGNOSTIC_IDR_REQUEST_SENT:
+            destination = &videoDiagnostics.idrRequestsSent;
+            break;
+        default:
+            return;
+    }
+
+    __atomic_fetch_add(destination, amount, __ATOMIC_RELAXED);
+}
+
+bool LiGetVideoStreamDiagnosticsSnapshot(VideoStreamDiagnostics* snapshot) {
+    if (snapshot == NULL) {
+        return false;
+    }
+
+    snapshot->rtpPacketsOutOfSequence = __atomic_load_n(
+        &videoDiagnostics.rtpPacketsOutOfSequence, __ATOMIC_RELAXED);
+    snapshot->fecDataPacketsRecovered = __atomic_load_n(
+        &videoDiagnostics.fecDataPacketsRecovered, __ATOMIC_RELAXED);
+    snapshot->fecBlocksFailed = __atomic_load_n(
+        &videoDiagnostics.fecBlocksFailed, __ATOMIC_RELAXED);
+    snapshot->networkFramesLost = __atomic_load_n(
+        &videoDiagnostics.networkFramesLost, __ATOMIC_RELAXED);
+    snapshot->depacketizerCorruptFrames = __atomic_load_n(
+        &videoDiagnostics.depacketizerCorruptFrames, __ATOMIC_RELAXED);
+    snapshot->decodeUnitQueueOverflows = __atomic_load_n(
+        &videoDiagnostics.decodeUnitQueueOverflows, __ATOMIC_RELAXED);
+    snapshot->idrRequestsSent = __atomic_load_n(
+        &videoDiagnostics.idrRequestsSent, __ATOMIC_RELAXED);
+    return true;
+}
